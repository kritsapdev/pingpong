{
    "name": "ping-pong-game",
    "version": "1.0.0",
    "description": "A simple Ping Pong game.",
    "main": "main.js",
    "scripts": {
        "start": "npx -p @electron-forge/cli electron-forge start",
        "package": "npx -p @electron-forge/cli electron-forge package",
        "make": "npx -p @electron-forge/cli electron-forge make"
    },
    "author": "Jules",
    "license": "ISC",
    "devDependencies": {
        "@electron-forge/cli": "^7.8.3",
        "@electron-forge/maker-deb": "^7.8.3",
        "@electron-forge/maker-rpm": "^7.8.3",
        "@electron-forge/maker-squirrel": "^7.8.3",
        "@electron-forge/maker-zip": "^7.8.3",
        "electron": "^28.0.0"
    },
    "config": {
        "forge": {
            "packagerConfig": {},
            "makers": [
                {
                    "name": "@electron-forge/maker-squirrel",
                    "config": {
                        "name": "ping_pong_game"
                    }
                },
                {
                    "name": "@electron-forge/maker-zip",
                    "platforms": [
                        "darwin"
                    ]
                },
                {
                    "name": "@electron-forge/maker-deb",
                    "config": {}
                },
                {
                    "name": "@electron-forge/maker-rpm",
                    "config": {}
                }
            ]
        }
    }
}
